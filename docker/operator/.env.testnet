# ================================
# INTEGRATED ENVIRONMENT CONFIGURATION
# BitVMX + Union Bridge Client
# ================================

COMPOSE_PROJECT_NAME=union-operator

# ================================
# General Settings
# ================================
PLATFORM=linux/amd64
ENVIRONMENT=testnet
ENV_NAME=docker-testnet

# ================================
# BitVMX Configuration
# ================================
BITCOIND_URL=http://bitcoin:aTVQ5b0mS4y27qG@10.26.12.61:18332
# in local
# BITCOIND_URL=http://bitcoin:39048j03%40slk@bitcoind-testnet-use1.alphanet.rskcomputing.net:18332

# ================================
# Union Bridge Client Configuration
# ================================
# TODO: Coordinate with @Andres Tarrio on the RSK node IP/URL for Testnet
# in aws instance (points to RSK testnet node)
ROOTSTOCK_URL=ws://10.26.7.106:4445
# in local
# ROOTSTOCK_URL=ws://<RSK_TESTNET_HOSTNAME>:4445

# for container communication (union-client -> bitvmx-client)
BITVMX_HOST=host.docker.internal
BITVMX_PORT=22222

# User API port
USER_API_PORT=40001

# Key Management
KEY_STORE_PASSWORD=supersecret-to-change

# config paths
CONFIG_PATH=../config/docker/testnet
LOGGER_PATH=../build/log4rs.yaml
