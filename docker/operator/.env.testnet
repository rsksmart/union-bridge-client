# ================================
# INTEGRATED ENVIRONMENT CONFIGURATION
# BitVMX + Union Bridge Client
# ================================

COMPOSE_PROJECT_NAME=union-operator

# ================================
# General Settings
# ================================
PLATFORM=linux/amd64
ENVIRONMENT=testnet
ENV_NAME=docker-testnet

# ================================
# BitVMX Configuration
# ================================
BITCOIND_URL=http://bitcoin:aTVQ5b0mS4y27qG@10.26.12.61:18332
# in local
# BITCOIND_URL=http://bitcoin:39048j03%40slk@bitcoind-testnet-use1.alphanet.rskcomputing.net:18332

# ================================
# Union Bridge Client Configuration
# ================================
# TODO: Coordinate with @Andres Tarrio on the RSK node IP/URL for Testnet
# in aws instance (points to RSK testnet node)
ROOTSTOCK_URL=ws://10.26.7.106:4445
# in local
# ROOTSTOCK_URL=ws://<RSK_TESTNET_HOSTNAME>:4445

# for container communication (union-client -> bitvmx-client)
BITVMX_HOST=host.docker.internal
BITVMX_PORT=22222

# User API port
USER_API_PORT=40001

# BitVMX DRP program YAML path inside the container (repo: resources/hello-world.yaml).
# Must be set in each docker/operator/.env.* — empty value causes BitVMX to exit.
UB__BRIDGE__COMMITTEE__DRP_PROGRAM_DEFINITION=/app/resources/hello-world.yaml

# Key Management
KEY_STORE_PASSWORD=supersecret-to-change

# config paths
CONFIG_PATH=../config/docker/testnet
# LOGGER_PATH is set as an absolute path in start_operators.sh

# ================================
# Deployment Configuration
# ================================
# NOTE: UC_TAG, UC_OPERATOR_ID, and UC_OPERATOR_ROLE should be set in .envrc (project root), not here.
# The values below are fallback defaults only. Set them in .envrc to avoid passing flags.
# Docker image tag for Union Client (used by start_operators.sh)
# Can be overridden with --tag flag or set in .envrc
UC_TAG=latest-testnet

# Operator ID (1-4) for this host (used by cli-operations.sh apply-stream)
# Can be overridden with --operator-id flag or set in .envrc
# UC_OPERATOR_ID=1

# Operator role for this host (used by cli-operations.sh apply-stream)
# Options: prover, verifier
# Can be overridden with --role flag or set in .envrc
# UC_OPERATOR_ROLE=prover
