# ================================
# INTEGRATED ENVIRONMENT CONFIGURATION
# BitVMX + Union Bridge Client
# ================================
# Copy this file to .env.<environment> (e.g. .env.testnet) and fill in the values.

COMPOSE_PROJECT_NAME=union-operator

# ================================
# General Settings
# ================================
PLATFORM=linux/amd64
ENVIRONMENT=<testnet|alphanet|regtest>
ENV_NAME=docker-<environment>

# ================================
# BitVMX Configuration
# ================================
BITCOIND_URL=http://<user>:<password>@<host>:<port>

# ================================
# Union Bridge Client Configuration
# ================================
ROOTSTOCK_URL=ws://<rsk-node-host>:<port>

# Overrides the Rootstock URL in the TOML config (passed into containers)
UB__PROVIDER__ROOTSTOCK__URL=ws://<rsk-node-host>:<port>

# for container communication (union-client -> bitvmx-client)
BITVMX_HOST=host.docker.internal
BITVMX_PORT=22222

# User API port
USER_API_PORT=40001

# Key Management
KEY_STORE_PASSWORD=<your-keystore-password>

# config paths
CONFIG_PATH=../config/docker/<environment>
# LOGGER_PATH is set as an absolute path in start_operators.sh

# ================================
# Deployment Configuration
# ================================
# Docker image tag for Union Client (used by start_operators.sh)
# Can be overridden with --tag flag or set in .envrc
UC_TAG=latest-<environment>

# Number of operators to start (1-10) for this environment
# Can be overridden with --ops flag
# NUM_OPERATORS=4

# Operator ID (1-4) for this host (used by cli-operations.sh apply-stream)
# Can be overridden with --operator-id flag or set in .envrc
# UC_OPERATOR_ID=1

# Operator role for this host (used by cli-operations.sh apply-stream)
# Options: prover, verifier
# Can be overridden with --role flag or set in .envrc
# UC_OPERATOR_ROLE=prover

# ================================
# Infrastructure (used by cli-infra.sh and test scripts)
# ================================
# SSH hostname for the regtest instance (used by cli-infra.sh --start-regtest)
# REGTEST_HOST=<regtest-instance-hostname>

# Rootstock JSON-RPC URL (used by tests/run-happy-path-regtest.sh)
# RSK_RPC_URL=http://<rsk-node-host>:<port>

# Bitcoin RPC connection (used by tests/run-happy-path-regtest.sh)
# BITCOIN_RPC_HOST=<bitcoin-rpc-host>
# BITCOIN_RPC_PORT=18332
# BITCOIN_RPC_USER=<user>
# BITCOIN_RPC_PASSWORD=<password>
