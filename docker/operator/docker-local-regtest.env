# ================================
# Docker-first local Rootstock regtest
# ================================

COMPOSE_PROJECT_NAME=union-operator

# ================================
# General Settings
# ================================
PLATFORM=${PLATFORM:-linux/amd64}
CONFIG=docker-local-regtest

# ================================
# Union Bridge Client Configuration
# ================================
# The client reads Rootstock from config/docker-local-regtest.toml.
# Kept here for compatibility with scripts that inspect ROOTSTOCK_URL.
ROOTSTOCK_URL=ws://host.docker.internal:4445

# for container communication (union-client -> bitvmx-client)
BITVMX_HOST='bitvmx-client'
BITVMX_PORT=''

# User API port
USER_API_PORT=''

# deployment paths
CONFIG_DIR=../../config
RESOURCES_DIR=../../resources

# ================================
# Deployment Configuration
# ================================
UC_TAG=local-regtest

NUM_OPERATORS=4
SLOTS_PER_PACKAGE=10
