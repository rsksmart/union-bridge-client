# ================================
# INTEGRATED ENVIRONMENT CONFIGURATION
# BitVMX + Union Bridge Client
# ================================

COMPOSE_PROJECT_NAME=union-operator

# ================================
# General Settings
# ================================
PLATFORM=linux/amd64
ENVIRONMENT=local
ENV_NAME=docker-local

# ================================
# BitVMX Configuration
# ================================
BITCOIND_URL=http://foo:rpcpassword@host.docker.internal:18443

# ================================
# Union Bridge Client Configuration
# ================================
ROOTSTOCK_URL=ws://host.docker.internal:8545

# for container communication (union-client -> bitvmx-client)
BITVMX_HOST='bitvmx-client'
BITVMX_PORT='' # replaced in the script

# User API port
USER_API_PORT='' # replaced in the script

# Key Management
KEY_STORE_PASSWORD=supersecret-to-change

# config paths
LOGGER_PATH=../build/log4rs.yaml
# ================================
# Deployment Configuration
# ================================
# NOTE: UC_TAG, UC_OPERATOR_ID, and UC_OPERATOR_ROLE should be set in .envrc (project root), not here.
# The values below are fallback defaults only. Set them in .envrc to avoid passing flags.
# Docker image tag for Union Client (used by start_operators.sh)
# Can be overridden with --tag flag or set in .envrc
UC_TAG=latest-anvil

# Number of operators to start (1-10) for local environment
# Can be overridden with --ops flag
NUM_OPERATORS=10

# Operator ID (1-10) for this host (used by cli-operations.sh apply-stream)
# Can be overridden with --operator-id flag or set in .envrc
# Note: Local environment runs multiple operators (default 4, up to 10), so this is typically not needed
# UC_OPERATOR_ID=1

# Operator role for this host (used by cli-operations.sh apply-stream)
# Options: prover, verifier
# Can be overridden with --role flag or set in .envrc
# Note: Local environment runs all 4 operators, so this is typically not needed
# UC_OPERATOR_ROLE=prover
