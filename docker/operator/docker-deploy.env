# ================================
# INTEGRATED ENVIRONMENT CONFIGURATION
# BitVMX + Union Bridge Client
# ================================

COMPOSE_PROJECT_NAME=union-operator

# ================================
# General Settings
# ================================
PLATFORM=linux/amd64
CONFIG=docker

# ================================
# Union Bridge Client Configuration
# ================================
ROOTSTOCK_URL=ws://host.docker.internal:8545

# for container communication (union-client -> bitvmx-client)
BITVMX_HOST='bitvmx-client'
BITVMX_PORT='' # replaced in the script

# User API port
USER_API_PORT='' # replaced in the script

# deployment paths
# docker compose defaults to repo-relative paths when these are unset.
# Set CONFIG_DIR and RESOURCES_DIR to staged deployment copies when needed.
CONFIG_DIR=../../config
RESOURCES_DIR=../../resources

# logger path
# docker/build/docker-compose.yml uses its own default for LOGGER_PATH when unset.
# ================================
# Deployment Configuration
# ================================
# Docker image tag for Union Client (used by start-operators.sh)
# Can be overridden with --tag or an exported UC_TAG
UC_TAG=latest-anvil

# Number of operators to start (1-10) for local environment
# Can be overridden with --ops flag.
# 1 selects docker-compose.one.yml; 2-10 select docker-compose.all.yml.
NUM_OPERATORS=4

# Local protocol sizing. The application fallback remains 100 when this env var is unset.
SLOTS_PER_PACKAGE=10
COMMITTEE_MEMBER_COUNT=4
COMMITTEE_PROVER_COUNT=2
