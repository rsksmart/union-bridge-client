# ================================
# INTEGRATED ENVIRONMENT CONFIGURATION
# BitVMX + Union Bridge Client
# ================================

COMPOSE_PROJECT_NAME=union-operator

# ================================
# General Settings
# ================================
PLATFORM=linux/amd64
ENVIRONMENT=local
ENV_NAME=docker-local

# ================================
# BitVMX Configuration
# ================================
BITCOIND_URL=http://foo:rpcpassword@host.docker.internal:18443

# ================================
# Union Bridge Client Configuration
# ================================
ROOTSTOCK_URL=ws://host.docker.internal:8545

# for container communication (union-client -> bitvmx-client)
BITVMX_HOST='bitvmx-client'
BITVMX_PORT='' # replaced in the script

# User API port
USER_API_PORT='' # replaced in the script

# Key Management
KEY_STORE_PASSWORD=supersecret-to-change

# config paths
LOGGER_PATH=../client/log4rs.yaml

# ================================================
# Blockchains stack configuration (only local)
# ================================================
# path of the contracts code for building
CONTRACTS_CONTEXT_PATH=../../../bitvmx-union-bridge-contracts
# since Docker Compose context will be CONTRACTS_CONTEXT_PATH, the Dockerfile will be looked up relative to this path so we have to go back to the docker-integrated folder
CONTRACTS_DOCKERFILE=../union-bridge-client/docker/integrated/Dockerfile_contracts
# Anvil mnemonic (do not change, otherwise the smart contracts addresses will change)
MNEMONIC="test test test test test test test test test test test junk"
# Index of the deployer account
DEPLOYER_INDEX=0
# Anvil private key 2 (needs to be different than the deployer to avoid changing smart contracts address)
FUNDING_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# for bitcoind setup
BITCOIND_USER=foo
BITCOIND_PASSWORD=rpcpassword