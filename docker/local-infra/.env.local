# ================================================
# BitVMX configuration (only local)
# ================================================

ENVIRONMENT=local
BITCOIND_URL=http://foo:rpcpassword@host.docker.internal:18443
#just to avoid complains, docker is not detecting that we define it on overlay
CLIENT_OP=111

# ================================================
# Blockchains stack configuration (only local)
# ================================================
ANVIL_URL=ws://anvil:8545
ANVIL_RPC_URL=http://anvil:8545
# Path to contracts repo for --contracts-tag local-build (build from local source)
# Default: start_blockchains.sh uses contracts version from Cargo.toml (pulls from registry)
# Override: --contracts-tag local-build or --contracts-tag <registry-tag>
CONTRACTS_CONTEXT_PATH=../../../bitvmx-union-bridge-contracts
# since Docker Compose context will be CONTRACTS_CONTEXT_PATH, the Dockerfile will be looked up relative to this path so we have to go back to the docker/local-infra folder
CONTRACTS_DOCKERFILE=../union-bridge-client/docker/local-infra/Dockerfile_contracts
# Anvil mnemonic (do not change, otherwise the smart contracts addresses will change)
MNEMONIC="test test test test test test test test test test test junk"
# Index of the deployer account
DEPLOYER_INDEX=0
# Anvil private key 2 (needs to be different than the deployer to avoid changing smart contracts address)
FUNDING_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# for bitcoind setup
BITCOIND_USER=foo
BITCOIND_PASSWORD=rpcpassword