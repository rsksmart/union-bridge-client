# ================================================
# Bitcoind credentials (consumed by anvil/docker-compose.yaml and the parent
# orchestrator's bitcoind helpers)
# ================================================
BITCOIND_USER=foo
BITCOIND_PASSWORD=rpcpassword

# ================================================
# Anvil predeployed-contracts image
# ================================================
PREDEPLOYED_ANVIL_IMAGE_BASE=ghcr.io/rsksmart/union-bridge-contracts-anvil
# Path to contracts repo for --contracts-tag local-build (build from local source).
# Default: anvil/start.sh uses the contracts version from Cargo.toml (pulls from registry).
# Override: --contracts-tag local-build or --contracts-tag <registry-tag>.
CONTRACTS_CONTEXT_PATH=../../../union-bridge-contracts
# Docker Compose's build context is CONTRACTS_CONTEXT_PATH, so this path is relative to it.
PREDEPLOYED_ANVIL_DOCKERFILE=../union-bridge-client/docker/local-infra/anvil/Dockerfile_predeployed

# Anvil chain ID.
CHAIN_ID=31337
# Anvil mnemonic — do not change; the deterministic smart-contract addresses depend on it.
MNEMONIC="test test test test test test test test test test test junk"
# Mnemonic index used by the contracts deployer.
DEPLOYER_INDEX=0
