# ================================================
# Bitcoind credentials (consumed by rskj/docker-compose.yaml and the parent
# orchestrator's bitcoind helpers)
# ================================================
BITCOIND_USER=foo
BITCOIND_PASSWORD=rpcpassword

# ================================================
# RSKj + powpeg stack configuration
# ================================================
RSKJ_HTTP_URL=http://rskj:4444
RSKJ_HOST_HTTP_URL=http://127.0.0.1:8545
RSKJ_WS_URL=ws://rskj:4445

# Official Docker Hub tags can be overridden with:
#   ./cli-infra.sh --env local-rskj --start-blockchains --fresh --rskj-tag <tag> --powpeg-tag <tag>
# Tag catalogs:
#   https://hub.docker.com/r/rsksmart/rskj/tags
#   https://hub.docker.com/r/rsksmart/powpeg-node/tags
RSKJ_TAG=VETIVER-9.0.1
POWPEG_TAG=VETIVER-9.0.0.0
PLATFORM=linux/amd64

# Deterministic p2p identity for the local rskj peer wiring.
RSKJ_PEER_PRIVATE_KEY=ee4916cc862dd53763ee157b3a8bef8ee101dad8962412c606db0f2ae6d261ca
RSKJ_NODE_ID=5c2c05cc204e207add3b25846af7251a734dabb6d020127db84369548e7bbe00340cfa0327bd1699a41d93d800170e3cb6f3fe13406b34b4f7ddb17f1f142d54

# Rootstock regtest COW account private key (pre-funded in the genesis).
RSKJ_COW_PRIVATE_KEY=0xc85ef7d79691fe79573b1a7064c19c1a9819ebdbd1faaab1a8ec92344438aaf4
DEPLOYER_PREFUND_VALUE=100ether

# Contracts repo path (relative to docker/local-infra/rskj/) used as the
# deploy-contracts build context.
CONTRACTS_CONTEXT_PATH=../../../union-bridge-contracts

# Contracts deploy mnemonic / index (kept deterministic so addresses stay stable).
MNEMONIC="test test test test test test test test test test test junk"
DEPLOYER_INDEX=0

# BTC regtest blocks mined on first --fresh boot so the federation has mature funds.
LOCAL_RSKJ_BOOTSTRAP_BTC_BLOCKS=25
