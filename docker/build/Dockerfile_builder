# Custom Rust builder image
FROM rust:1.98-slim-bookworm@sha256:1469a27c125cb5a3aebfa4f4e4665d935b02fb72cc093b2c974b3d740e43f157

# Install build dependencies
RUN apt-get update && apt-get install -y \
    clang \
    libclang-dev \
    llvm-dev \
    build-essential \
    pkg-config \
    libssl-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# [coordinator Specific] Install Risc0 toolchain
# Just needed for build stage, so it won't impact the final runtime image size, therefore is safe to install it always
RUN set -e && \
    curl -L https://risczero.com/install | bash && \
    ~/.risc0/bin/rzup install && \
    cp -r ~/.risc0 /opt/risc0

LABEL org.opencontainers.image.source=https://github.com/rsksmart/union-bridge-client
