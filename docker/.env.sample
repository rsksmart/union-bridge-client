# ================================
# INTEGRATED ENVIRONMENT CONFIGURATION
# BitVMX + Union Bridge Client
# ================================
# Copy this file to .env.<environment> (e.g. .env.testnet) and fill in the values.

COMPOSE_PROJECT_NAME=union-operator

# ================================
# General Settings
# ================================
PLATFORM=linux/amd64
ENVIRONMENT=<testnet|alphanet|regtest>
ENV_NAME=docker-<environment>

# ================================
# BitVMX Configuration
# ================================
BITCOIND_URL=http://<user>:<password>@<host>:<port>

# ================================
# Union Bridge Client Configuration
# ================================
ROOTSTOCK_URL=ws://<rsk-node-host>:<port>

# for container communication (union-client -> bitvmx-client)
BITVMX_HOST=host.docker.internal
BITVMX_PORT=22222

# User API port
USER_API_PORT=40001

# Key Management
KEY_STORE_PASSWORD=<your-keystore-password>

# config paths
# LOGGER_PATH is set as an absolute path in start_operators.sh
