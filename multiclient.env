# Multi-client environment configuration
# These variables define port numbers and configuration for each client instance
#
# Note: Each client has TWO wallets created by the wallet setup:
#   - op-N-member: for committee member operations (default, configured below)
#   - op-N-user: for user/transaction operations
# You can switch between them by updating UB__KEY_STORE__*_PATH_N variables
#
# Broker pubkey hashes are referenced through *_PUBKEY_HASH_FILE_N entries.
# Run `./cli-operations.sh setup create-broker-identities` before `./cli-run.sh`.

# Client 1
UB__BLOCK_INDEXER__NOTIFIER__PORT_1=10001
UB__LOG_INDEXER__NOTIFIER__PORT_1=20001
UB__COORDINATOR__BLOCKS__PORT_1=10001
# TODO(iago) change layout to .union_bridge/op_1/..., .union_bridge/op_2/... etc for local and for docker
UB__COORDINATOR__BLOCKS__PUBKEY_HASH_FILE_1=.union_bridge/broker/block-indexer/op_1.pubkey_hash
UB__COORDINATOR__LOGS__PORT_1=20001
UB__COORDINATOR__LOGS__PUBKEY_HASH_FILE_1=.union_bridge/broker/log-indexer/op_1.pubkey_hash
UB__COORDINATOR__USER__PORT_1=30001
UB__COORDINATOR__USER__PUBKEY_HASH_FILE_1=.union_bridge/broker/user-api/op_1.pubkey_hash
UB__COORDINATOR__BROKER__CLIENT_ID_1=101
UB__COORDINATOR__BITVMX__PORT_1=22222
UB__BRIDGE__COMMITTEE__DRP_PROGRAM_DEFINITION_1=/app/resources/hello-world.yaml
UB__INDEXER__STORAGE__PATH_1=op_1
UB__COORDINATOR__STORAGE_PATH_1=op_1
UB__KEY_STORE__MEMBER_PATH_1=op_1-member
UB__KEY_STORE__USER_PATH_1=op_1-user
UB__BLOCK_INDEXER__BROKER_KEY_PATH_1=.union_bridge/broker/block-indexer/op_1.pem
UB__LOG_INDEXER__BROKER_KEY_PATH_1=.union_bridge/broker/log-indexer/op_1.pem
UB__USER_API__BROKER_KEY_PATH_1=.union_bridge/broker/user-api/op_1.pem
UB__COORDINATOR__BROKER__KEY_PATH_1=.union_bridge/broker/coordinator/op_1.pem
# Temporary coordinator routing vars for user-api broker messages.
# Remove these USER_API__COORDINATOR__* entries when user-api is removed.
UB__USER_API__COORDINATOR__CLIENT_ID_1=101
UB__USER_API__COORDINATOR__PUBKEY_HASH_FILE_1=.union_bridge/broker/coordinator/op_1.pubkey_hash
UB__USER_API__NOTIFIER__PORT_1=30001
UB__USER_API__HTTP__PORT_1=40001
CLIENT_ID_1=1

