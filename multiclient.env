# Multi-client environment configuration
# These variables define port numbers and configuration for each client instance
#
# Note: Each client has TWO wallets created by the wallet setup:
#   - multi-client-N-member: for committee member operations (default, configured below)
#   - multi-client-N-user: for user/transaction operations
# You can switch between them by updating UB__TRANSACTION_DISPATCHER__KEY_STORE__*_PATH_N variables

# Client 1
UB__BLOCK_INDEXER__NOTIFIER__PORT_1=10001
UB__LOG_INDEXER__NOTIFIER__PORT_1=20001
UB__COORDINATOR__BLOCKS__PORT_1=10001
UB__COORDINATOR__LOGS__PORT_1=20001
UB__COORDINATOR__USER__PORT_1=30001
UB__COORDINATOR__BROKER__CLIENT_ID_1=101
UB__COORDINATOR__BITVMX__PORT_1=22222
UB__INDEXER__STORAGE__PATH_1=multi-client/1
UB__COORDINATOR__STORAGE_PATH_1=multi-client/1
UB__TRANSACTION_DISPATCHER__KEY_STORE__MEMBER_PATH_1=multi-client-1-member
UB__TRANSACTION_DISPATCHER__KEY_STORE__USER_PATH_1=multi-client-1-user
UB__USER_API__COORDINATOR__BROKER__CLIENT_ID_1=101
UB__USER_API__NOTIFIER__PORT_1=30001
UB__USER_API__HTTP__PORT_1=40001
CLIENT_ID_1=1

