STORAGE_PATH_2=multi-client/2
KEY_STORE_PATH_2=multi-client-2-member
SERVER_URL_2=0.0.0.0:9002
COORDINATOR_BROKER_CLIENT_ID_2=102
BROKER_SERVER_PORT_2=30002
HTTP_SERVER_PORT_2=40002
BITVMX_BROKER_PORT_2=33333

