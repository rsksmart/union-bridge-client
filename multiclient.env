# Multi-client environment configuration
# These variables define port numbers and configuration for each client instance
#
# Note: Each client has TWO wallets created by the wallet setup:
#   - multi-client-N-member: for committee member operations (default, configured below)
#   - multi-client-N-user: for user/transaction operations
# You can switch between them by updating KEY_STORE_PATH_N variables

# Client 1
BLOCK_NOTIFIER_BROKER_PORT_1=10001
LOG_NOTIFIER_BROKER_PORT_1=20001
BLOCK_BROKER_PORT_1=10001
LOG_BROKER_PORT_1=20001
USER_BROKER_PORT_1=30001
BROKER_CLIENT_ID_1=101
STORAGE_PATH_1=multi-client/1
KEY_STORE_PATH_1=multi-client-1-member
SERVER_URL_1=0.0.0.0:9001
COORDINATOR_BROKER_CLIENT_ID_1=101
BROKER_SERVER_PORT_1=30001
HTTP_SERVER_PORT_1=40001
BITVMX_BROKER_PORT_1=22222

# Client 2
