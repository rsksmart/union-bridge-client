# Testomat.io Configuration
# Copy this file to .envrc.testomat and fill in your actual credentials

# Your Testomat API key (get this from your Testomat.io dashboard)
export TESTOMAT_API_KEY="your_testomat_api_key_here"

# Your Testomat project ID (get this from your Testomat.io dashboard)
export TESTOMAT_PROJECT_ID="your_testomat_project_id_here"

# Optional: Testomat API URL (usually not needed to change)
export TESTOMAT_API_URL="https://app.testomat.io"

# Optional: Test run environment
export TESTOMAT_ENVIRONMENT="local"

# Optional: Test run name prefix
export TESTOMAT_RUN_NAME_PREFIX="Union Bridge" 