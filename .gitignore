# Environment and local shell configuration
**/.env
**/.env.*
!**/.env.sample
!**/.env.example
!docker/local-infra/.env.local
**/.envrc
**/.actrc
cli/.env.*
!cli/.env.sample

# bitcoin-wallet network configs hold real node RPC creds and are gitignored.
# Exceptions: regtest.toml (standard local creds) and the sample template stay tracked.
cli/bitcoin-wallet/config/*.toml
!cli/bitcoin-wallet/config/regtest.toml
!cli/bitcoin-wallet/config/sample.toml

# Build artifacts and runtime outputs
**/target
**/app.log*
*.log
**/logs/*
**/.db
test_keystore
docs/local/
docs/node_modules/

# ZK artifacts
**/check_fork_args.bin
**/stark-proof.bin
**/docker-compose.fetched.yml

# Editor and OS files
.vscode/*
.idea
.cursor
.claude
.DS_Store
.intent
.air

# Local tooling
**/.llmignore
.junie/memory
.union_bridge

# Private keys and certificates
**/*.key
**/*.pem
**/*.cert
**/*.p12
**/*.pfx

# MemPalace per-project files
mempalace.yaml
entities.json
