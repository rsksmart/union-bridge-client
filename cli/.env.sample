# Copy this file to cli/.env.<profile>, for example cli/.env.alphanet.
# Any CLI environment name other than `local` or `docker` is treated as a
# remote profile and loads the matching file from this directory.

export UC_REMOTE_SSH_USER="<remote_ssh_user>"
export UC_REMOTE_HOSTS="<host1>,<host2>,<host3>,<host4>"
export UC_REMOTE_USER_API_ENDPOINTS="<host1:40001>,<host2:40002>,<host3:40003>,<host4:40004>"
export UC_REMOTE_RPC_URL="http://<remote-rpc-host>:4444"
