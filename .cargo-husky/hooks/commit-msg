#!/usr/bin/env bash
# Installed by cargo-husky from .cargo-husky/hooks/commit-msg.
# Keep this entrypoint thin — the real work lives in
# .hooks/check-commit-message.sh so edits there take effect without re-running
# cargo build.

set -e
exec bash "$(git rev-parse --show-toplevel)/.hooks/check-commit-message.sh" "$1"
