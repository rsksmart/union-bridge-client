# Local committee environment configuration
# These variables define port numbers and configuration for each client instance
#
# Note: Each client has TWO wallets created under .union_bridge/op_N/union-client/keystore:
#   - member: for committee member operations (default, configured below)
#   - user: for user/transaction operations
# You can switch between them by updating UB__KEY_STORE__*_PATH_N variables
#
# Service pubkey hashes are referenced through *_PUBKEY_HASH_FILE_N entries.
# Run `./scripts/setup-operators.sh --ops 4` before `./scripts/run-clients.sh`.

# Client 1
UB__BLOCK_INDEXER__NOTIFIER__PORT_1=10001
UB__BLOCK_INDEXER__COORDINATOR__CLIENT_ID_1=101
UB__BLOCK_INDEXER__COORDINATOR__PUBKEY_HASH_FILE_1=.union_bridge/op_1/union-client/broker/coordinator.pubkey_hash
UB__LOG_INDEXER__NOTIFIER__PORT_1=20001
UB__LOG_INDEXER__COORDINATOR__CLIENT_ID_1=101
UB__LOG_INDEXER__COORDINATOR__PUBKEY_HASH_FILE_1=.union_bridge/op_1/union-client/broker/coordinator.pubkey_hash
UB__COORDINATOR__BLOCKS__PORT_1=10001
UB__COORDINATOR__BLOCKS__PUBKEY_HASH_FILE_1=.union_bridge/op_1/union-client/broker/block-indexer.pubkey_hash
UB__COORDINATOR__LOGS__PORT_1=20001
UB__COORDINATOR__LOGS__PUBKEY_HASH_FILE_1=.union_bridge/op_1/union-client/broker/log-indexer.pubkey_hash
UB__COORDINATOR__USER__PORT_1=30001
UB__COORDINATOR__USER__PUBKEY_HASH_FILE_1=.union_bridge/op_1/union-client/broker/user-api.pubkey_hash
UB__COORDINATOR__BROKER__CLIENT_ID_1=101
UB__COORDINATOR__BITVMX__PORT_1=22222
# this is ignored if BitVMX is run from repo (not docker) and base.toml value is used
UB__COORDINATOR__BITVMX__PUBKEY_HASH_FILE_1=.union_bridge/op_1/bitvmx/keys/services.pubkey_hash
UB__INDEXER__STORAGE__PATH_1=op_1/local_database
UB__COORDINATOR__STORAGE_PATH_1=op_1/local_database
UB__KEY_STORE__MEMBER_PATH_1=op_1/union-client/keystore/member
UB__KEY_STORE__USER_PATH_1=op_1/union-client/keystore/user
UB__BLOCK_INDEXER__BROKER_KEY_PATH_1=.union_bridge/op_1/union-client/broker/block-indexer.pem
UB__LOG_INDEXER__BROKER_KEY_PATH_1=.union_bridge/op_1/union-client/broker/log-indexer.pem
UB__USER_API__BROKER_KEY_PATH_1=.union_bridge/op_1/union-client/broker/user-api.pem
UB__COORDINATOR__BROKER__KEY_PATH_1=.union_bridge/op_1/union-client/broker/coordinator.pem
# Temporary coordinator routing vars for user-api broker messages.
# Remove these USER_API__COORDINATOR__* entries when user-api is removed.
UB__USER_API__COORDINATOR__CLIENT_ID_1=101
UB__USER_API__COORDINATOR__PUBKEY_HASH_FILE_1=.union_bridge/op_1/union-client/broker/coordinator.pubkey_hash
UB__USER_API__NOTIFIER__PORT_1=30001
UB__USER_API__HTTP__PORT_1=40001
# Prometheus /metrics endpoints per operator (base.toml defaults collide when
# all 4 operators bind to 0.0.0.0). Layout: 91<op_idx><svc> where op_idx is
# zero-based and svc is 1=coordinator, 2=user-api, 3=block-indexer, 4=log-indexer.
UB__COORDINATOR__MONITORING__BIND_ADDR_1=0.0.0.0:9201
UB__USER_API__MONITORING__BIND_ADDR_1=0.0.0.0:9202
UB__BLOCK_INDEXER__MONITORING__BIND_ADDR_1=0.0.0.0:9203
UB__LOG_INDEXER__MONITORING__BIND_ADDR_1=0.0.0.0:9204
CLIENT_ID_1=1

