UB__KEY_STORE__MEMBER_PATH_2=op_2/keystore/member
UB__KEY_STORE__USER_PATH_2=op_2/keystore/user
UB__BLOCK_INDEXER__BROKER_KEY_PATH_2=.union_bridge/op_2/broker/block-indexer.pem
UB__LOG_INDEXER__BROKER_KEY_PATH_2=.union_bridge/op_2/broker/log-indexer.pem
UB__USER_API__BROKER_KEY_PATH_2=.union_bridge/op_2/broker/user-api.pem
UB__COORDINATOR__BROKER__KEY_PATH_2=.union_bridge/op_2/broker/coordinator.pem
UB__USER_API__COORDINATOR__CLIENT_ID_2=102
UB__USER_API__COORDINATOR__PUBKEY_HASH_FILE_2=.union_bridge/op_2/broker/coordinator.pubkey_hash
