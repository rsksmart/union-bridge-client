############################################################
# For GitHub Container Registry
############################################################
export GITHUB_REGISTRY_TOKEN="<your_token_here>"

############################################################
# For local client running
############################################################
# Path where keystore, databases and other persistent data will be stored
# When not using --utxo-db / WALLET_UTXO_DB, the wallet will use "$BASE_STORAGE_PATH/<utxo_db_path from config>"
export BASE_STORAGE_PATH="<path/to/your/storage>"
# for transaction dispatcher
export KEY_STORE_PASSWORD="<super-secret-password>"
# optional (with fallback)
export CHECK_FORK_REQUIRED_NUM_BLOCKS=5
# Temporary until we gather them from contracts; must match current contract values
export SLOTS_PER_PACKAGE=10
export COMMITTEE_MEMBER_COUNT=4
export COMMITTEE_PROVER_COUNT=2

############################################################
# Deployment and Operations (Multi-host environments)
############################################################
# Default environment for start_operators.sh and scripts/operations.sh
# Options: local, docker, or a remote profile name such as alphanet
# export UC_ENV="local"
# Deployment variables (can be overridden via command-line flags)
# export UC_TAG="latest-anvil"
# export UC_OPERATOR_ID=1
# export UC_OPERATOR_ROLE="prover"
#
# Remote CLI profiles use cli/.env.<profile>.
# Copy cli/.env.sample to cli/.env.alphanet, cli/.env.testnet, etc.

############################################################
# Bitcoin
############################################################
# User WIF for peg-in/peg-out operations
export USER_BITCOIN_WIF="<user_wif_private_key>"
# Member/Operator WIF for BitVMX operations
export MEMBER_BITCOIN_WIF="<member_wif_private_key>"
export BITCOIN_NETWORK=regtest
# Bitcoind connection URL. THE single source of the Bitcoin RPC credentials for everything:
#   - BitVMX configs (patched as-is by scripts/setup-operators.sh),
#   - the bundled bitcoind server + bring-up scripts (docker-compose / start-blockchains), and
#   - host-side tooling (scripts/run-infra.sh, scripts/test-flows.sh).
# The bring-up + host tooling resolve only the user:password from it via
# docker/local-infra/bitcoind-rpc-env.sh, talking to 127.0.0.1:18443 (host-side tools use the regtest
# default host/port; BitVMX and the wallet CLI honor a non-default host/port via their own URLs). Use
# host.docker.internal in the URL so the in-container BitVMX clients can reach the host's bitcoind.
# Point it at a bring-your-own bitcoind to switch (e.g. a test-chain-miner stack:
# http://reorgtest:reorgtest@host.docker.internal:18443).
export BITCOIND_URL="http://foo:rpcpassword@host.docker.internal:18443"
# Bitcoind wallet name for host-side bitcoin-cli ops (not part of the URL). Override for a
# bring-your-own bitcoind whose funded wallet differs (a test-chain-miner stack uses "reorg").
export BITCOIN_WALLET=mainwallet
