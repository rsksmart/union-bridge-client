############################################################
# Mocking crate
############################################################
export UNION_CONTRACTS_PATH="path/to/your/contracts"
export UNION_CONTRACTS_DEPLOY_SCRIPT="shell/script/deploy/deploy-local.sh"
export UNION_CONTRACTS_SETUP_SCRIPT="shell/script/integration-test/packet-creation-flow.sh"

############################################################
# Local Github Actions (Act)
############################################################
export FAIRGATE_GITHUB_TOKEN="<your_github_token>"
export UNION_CONTRACTS_GITHUB_TOKEN="<your_github_token>"

############################################################
# For GitHub Container Registry
############################################################
export GITHUB_REGISTRY_TOKEN="<your_token_here>"

############################################################
# For local client running
############################################################
# Path where keystore, databases and other persistent data will be stored
# When not using --utxo-db / WALLET_UTXO_DB, the wallet will use "$BASE_STORAGE_PATH/<utxo_db_path from config>"
export BASE_STORAGE_PATH="<path/to/your/storage>"
# for transaction dispatcher
export KEY_STORE_PASSWORD="<super-secret-password>"
# optional (with fallback)
export CHECK_FORK_REQUIRED_NUM_BLOCKS=5

############################################################
# Deployment and Operations (Multi-host environments)
############################################################
# Default environment for start_operators.sh and cli-operations.sh
# Options: local, local-docker, regtest, alphanet, testnet (for start_operators.sh)
#          local, local-docker, alphanet, testnet (for cli-operations.sh)
# export UC_ENV="local"
# Deployment variables (can be overridden via command-line flags)
# export UC_TAG="latest-anvil"
# export UC_OPERATOR_ID=1
# export UC_OPERATOR_ROLE="prover"

############################################################
# Bitcoin
############################################################
# User WIF for peg-in/peg-out operations
export USER_BITCOIN_WIF="<user_wif_private_key>"
# Member/Operator WIF for BitVMX operations
export MEMBER_BITCOIN_WIF="<member_wif_private_key>"
export BITCOIN_NETWORK=regtest
