# ================================
# INTEGRATED ENVIRONMENT CONFIGURATION
# BitVMX + Union Bridge Client
# ================================

COMPOSE_PROJECT_NAME=union-operator

# ================================
# General Settings
# ================================
PLATFORM=linux/amd64
ENVIRONMENT=alphanet

# ================================
# BitVMX Configuration
# ================================
# in aws instance (points to bitcoind-testnet-use1.alphanet.rskcomputing.net)
BITCOIND_URL=http://bitcoin:39048j03%40slk@10.1.0.23:18332
# in local
# BITCOIND_URL=http://bitcoin:39048j03%40slk@bitcoind-testnet-use1.alphanet.rskcomputing.net:18332

# ================================
# Union Bridge Client Configuration
# ================================
# in aws instance (points to node-use1-1.alphanet.rskcomputing.net)
ROOTSTOCK_URL=ws://10.1.0.53:4445
# in local
# ROOTSTOCK_URL=ws://node-use1-1.alphanet.rskcomputing.net:4445

# for container communication (union-client -> bitvmx-client)
BITVMX_HOST=host.docker.internal

# Key Management
KEY_STORE_PASSWORD=supersecret-to-change

# config paths
CONFIG_PATH=../config/docker/alphanet
LOGGER_PATH=../docker/log4rs.yaml
